<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="AllFilesAccessPolicy,ScopedStorage" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:ignore="RequestInstallPackagesPolicy" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 通知栏遮盖防护（防 tapjacking）：令恶意悬浮窗无法盖在门禁/设置
         密码框上偷窥或劫持输入（MainActivity.applyOverlayProtection） -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <!-- 超时销毁到期复查闹钟（精确档）权限组合：
         31-32：SCHEDULE_EXACT_ALARM 安装即授予（仅限这两个版本，13+ 默认拒绝）
         33+  ：USE_EXACT_ALARM 安装即授予且不可撤销——本 app 核心功能即
                "计时雷管"，符合该权限设计语义；sideload 分发，无 Play 政策约束
         运行时仍保留 canScheduleExactAlarms 探测降级（兜底：Android 12 用户
         手动撤销等罕见情形，降级 setAndAllowWhileIdle，销毁推迟不缺席） -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"
        tools:ignore="ExactAlarmPolicy" />

    <application
        android:name=".LSPosedServiceManager"
        android:allowBackup="false"
        android:description="@string/application_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScreenshotFaker"
        tools:ignore="DataExtractionRules">
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ScreenshotFaker">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".MainActivityAlias"
            android:enabled="true"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".services.DisplayOverlayService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="@string/display_overlay_service_description"
                tools:ignore="ManifestResource" />
        </service>
        <service
            android:name=".services.ControlOverlayService"
            android:configChanges="orientation|screenSize"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="@string/control_overlay_service_description"
                tools:ignore="ManifestResource" />
        </service>
        <service
            android:name=".services.ScreenshotTileService"
            android:exported="true"
            android:icon="@drawable/ic_launcher_foreground"
            android:label="@string/stealth_screenshot"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".services.ScreenRecordTileService"
            android:exported="true"
            android:icon="@drawable/ic_launcher_foreground"
            android:label="@string/stealth_screen_recording"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".services.ScreenShareTileService"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_launcher_foreground"
            android:label="@string/stealth_screencast"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- 重启后的超时自毁检查：BOOT_COMPLETED 为受保护广播，仅系统可发 -->
        <receiver
            android:name=".services.BootCompletedReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- 超时销毁到期复查闹钟：检查通过但未到期时布防，到点无头复查
             （未到期则重新布防，链条自续）。不跨重启：重启由
             BootCompletedReceiver 接管链条。exported=false，仅本 app
             PendingIntent 可触发 -->
        <receiver
            android:name=".defense.AlarmReceiver"
            android:enabled="true"
            android:exported="false" />
    </application>
</manifest>